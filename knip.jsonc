{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Games are discovered with import.meta.glob('./*/index.ts'), so every game's index.ts is an entry.
  "entry": ["src/games/*/index.ts", "scripts/*.mjs", "src/kits/word/build-dict*.mjs"],
  "project": ["src/**/*.ts", "scripts/**/*.mjs", "test/**/*.ts"],
  "ignoreDependencies": [
    // Word-list data, loaded by the dictionary build scripts through computed require() paths.
    "wordlist-english",
    "@zxcvbn-ts/language-fr",
    "french-badwords-list",
    // Loaded by the Capacitor CLI and the Gradle project in android-foss/, not imported from src/.
    "@capacitor/android",
  ],
}
