{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "shots*/**",
    "src/kits/word/dict*.txt",
    "src/kits/word/common*.ts",
    "package-lock.json",
    "android/**",
    "android-foss/**",
    ".claude/**"
  ]
}
