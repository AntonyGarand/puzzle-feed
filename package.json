{
  "name": "puzzle-feed",
  "version": "0.1.0",
  "private": true,
  "description": "An endless feed of procedurally generated puzzles — puzzle.garand.dev",
  "homepage": "https://puzzle.garand.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntonyGarand/puzzle-feed.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:android": "vite build --mode android && cap sync android",
    "preview": "vite preview --host",
    "typecheck": "tsrs --noEmit -p .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run --dir test --exclude \"**/hints*.test.ts\" && vitest run --dir test hints",
    "test:coverage": "vitest run --dir test --coverage --exclude \"**/hints*.test.ts\"",
    "test:watch": "vitest",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run knip && npm run test",
    "dict": "node src/puzzles/wordkit/build-dict.mjs",
    "e2e:audit": "node scripts/audit.mjs",
    "e2e:a11y": "node scripts/a11y.mjs",
    "e2e:shots": "node scripts/shots.mjs",
    "fix": "oxfmt && oxlint --type-aware --fix"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.3",
    "an-array-of-french-words": "^2.0.0",
    "french-badwords-list": "^1.0.7",
    "happy-dom": "^21.0.4",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright-core": "^1.65.1",
    "tsrs": "^7.1.0-beta.tsrs3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wordlist-english": "^1.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
