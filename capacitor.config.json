{
  "appId": "dev.garand.puzzle.foss",
  "appName": "puzzle feed",
  "webDir": "dist",
  "android": {
    "path": "android-foss"
  },
  "server": {
    "hostname": "puzzle.garand.dev",
    "androidScheme": "https"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "keepUrlPathAfterReload": true,
      "appReadyTimeout": 10000
    }
  }
}
